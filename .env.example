# NARCHI V5 — exemple uniquement. Ne jamais committer le fichier .env réel.
# Génération recommandée : python -c "import secrets; print(secrets.token_urlsafe(64))"

APP_NAME="NARCHI V5 Unified Engine"
APP_VERSION="5.0.0-PROD"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Obligatoires en production (valeurs volontairement vides)
SECRET_KEY=
LEGACY_SHA256_SALT=
POSTGRES_PASSWORD=
# §51 — QDRANT_API_KEY supprimée : le RAG vit dans PostgreSQL (pgvector).
GRAFANA_ADMIN_PASSWORD=
# Format user:password
FLOWER_BASIC_AUTH=
# Port local de Flower; le script de déploiement choisit automatiquement un port libre.
FLOWER_HOST_PORT=5555

POSTGRES_USER=narchi
POSTGRES_DB=narchi_v3
DATABASE_URL=postgresql://narchi:CHANGE_ME@pgbouncer:5432/narchi_v3
DB_USE_PGBOUNCER=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

CORS_ORIGINS=["http://localhost:8080","https://narchi.de"]
FORCE_SECURE_COOKIES=false
COOKIE_DOMAIN=

REDIS_URL=redis://redis:6379/0
# §51 — QDRANT_URL supprimée (pgvector embarqué dans PostgreSQL).
# Sauvegardes pgBackRest : planification cron dans le conteneur db
# (plein dim. 03:30, incr. lun.-sam. 03:30 Europe/Paris). false = désactivé.
NARCHI_BACKUP_CRON_ENABLED=true
OPENAI_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AI_METER_EVENT_NAME=narchi_ai_audit
STRIPE_SUCCESS_URL=https://narchi.de/app/settings?billing=success
STRIPE_CANCEL_URL=https://narchi.de/app/settings?billing=cancelled

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# L'authentification locale hors-ligne est désactivée en production.
VITE_ENABLE_OFFLINE_AUTH=false

# Provisioning désactivé par défaut. Si activé, mots de passe >= 16 caractères.
NARCHI_SEED_DEFAULT_ADMINS=false
NARCHI_ADMIN_EMAIL=admin@narchi.de
NARCHI_ADMIN_PASSWORD=
NARCHI_OWNER_EMAIL=owner@narchi.io
NARCHI_OWNER_PASSWORD=

AK_BERLIN_GUEST_EMAIL=guest@ak-berlin.de
AK_BERLIN_GUEST_NAME="Gast Mitglied (AK Berlin)"
AK_BERLIN_GUEST_ID=AKB-2026-GUEST
MAX_UPLOAD_SIZE_BYTES=157286400

# Frontend IFC: /ifc/ en production; CDN versionné uniquement pour sandbox contrôlée.
VITE_IFC_WASM_BASE=/ifc/
VITE_FRAGMENTS_WORKER_URL=/ifc/fragments-worker.mjs
# Runtime Three.js versionné : évite le cache d'un ancien 404 après déploiement.
VITE_THREE_MODULE_FILE=three.module-0.185.1-narchi-v2.js
VITE_THREE_CORE_FILE=three.core-0.185.1-narchi-v2.js
# Ex. https://assets.narchi.de pour Cloudflare R2/Worker
VITE_ASSET_BASE=
