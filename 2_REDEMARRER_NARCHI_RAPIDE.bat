@echo off
setlocal EnableExtensions EnableDelayedExpansion
TITLE NARCHI - 2 REDEMARRAGE RAPIDE
COLOR 0A

rem ============================================================================
rem NARCHI - 2_REDEMARRER_NARCHI_RAPIDE.bat (100% AUTONOME)
rem
rem A utiliser APRES un redemarrage du PC ou de Docker Desktop :
rem relance la plateforme SANS tout reinstaller :
rem   - aucune donnee supprimee (base, projets, maquettes IFC conserves) ;
rem   - aucun mot de passe regenere (le .env existant est conserve) ;
rem   - pas de reconstruction --no-cache : bien plus rapide que
rem     1_DEMARRER_NARCHI.bat ou 3_REPARER_NARCHI_SANS_PERTE.bat.
rem
rem 100% AUTONOME : tout le code PowerShell est EMBARQUE dans CE fichier
rem (binaire Base64) -- aucun autre fichier necessaire, meme si le dossier
rem a ete copie partiellement.
rem ============================================================================

pushd "%~dp0"

where powershell.exe >nul 2>&1
if errorlevel 1 (
    echo [ERREUR] PowerShell est introuvable.
    goto FAIL
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 goto FAIL

goto END

:FAIL
echo.
echo [ECHEC] Relance impossible. Verifie que Docker Desktop tourne,
echo puis relance ce fichier. Premier deploiement du dossier :
echo lance d'abord 1_DEMARRER_NARCHI.bat une fois.

:END
echo.
pause
popd
endlocal
