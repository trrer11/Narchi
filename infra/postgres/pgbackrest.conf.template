# §51 — Configuration pgBackRest (stanza « narchi »).
# Template rendu au démarrage du conteneur (env vars officielles postgres).
# repo = sauvegardes physiques complètes + incrémentales + WAL (PITR).

[global]
repo1-path=/var/lib/pgbackrest
repo1-retention-full=2
repo1-retention-full-type=count
spool-path=/var/spool/pgbackrest
process-max=2
compress-type=gz
compress-level=3
start-fast=y
stop-auto=y
log-level-console=warn
log-level-file=info

[narchi]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-user=__POSTGRES_USER__
pg1-database=__POSTGRES_DB__
pg1-socket-path=/var/run/postgresql
