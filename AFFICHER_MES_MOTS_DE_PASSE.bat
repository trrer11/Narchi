@echo off
setlocal EnableExtensions EnableDelayedExpansion
TITLE NARCHI - AFFICHER MES MOTS DE PASSE
COLOR 0E

rem ============================================================================
rem NARCHI - AFFICHER_MES_MOTS_DE_PASSE.bat (100% AUTONOME)
rem
rem Affiche les identifiants stockes dans le .env de CE dossier :
rem   - compte proprietaire (login de l'application http://localhost:8080) ;
rem   - compte admin ;
rem   - supervision Grafana / Flower le cas echeant.
rem
rem 100% AUTONOME : tout le code PowerShell est EMBARQUE dans CE fichier
rem (binaire Base64) -- aucun autre fichier necessaire.
rem ============================================================================

pushd "%~dp0"

powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 goto FAIL

goto END

:FAIL
echo.
echo [ECHEC] Affichage impossible (voir message ci-dessus).

:END
echo.
pause
popd
endlocal
