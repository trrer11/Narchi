# §113 — exports de base (données réelles : JAMAIS dans git)
sauvegardes/*.sql.gz
sauvegardes/*.json
!sauvegardes/README.txt

# §121 — artefacts Playwright E2E (rapports, traces, captures d'échec)
test-results/
playwright-report/

# §119 - HTTPS local : certificats REELS (cle privee !) et bascule
# d'activation ne quittent jamais la machine - JAMAIS dans git.
infra/tls/certs/*
infra/tls/enabled/*
!infra/tls/certs/.gitkeep
!infra/tls/enabled/.gitkeep
