# Dependencies / virtual environments
node_modules/
.venv/
venv/

# Build and test outputs
dist/
build/
coverage/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vite/
vitest-report.xml
security-reports/
logs/

