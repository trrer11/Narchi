{
  "name": "narchi-v5-frontend",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0 --port 8080",
    "build": "vite build --config vite.config.ts",
    "build:arena": "vite build --config vite.config.singlefile.ts",
    "build:all": "npm run build && npm run build:arena",
    "build:singlefile": "vite build --config vite.config.singlefile.ts",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:security": "vitest run src/finance/SecureFinanceStore.test.ts src/auth/ChatSecurity.test.ts",
    "copy-ifc-assets": "node scripts/copy-ifc-assets.mjs",
    "predev": "npm run copy-ifc-assets && npm run build:vendor",
    "prebuild": "npm run copy-ifc-assets && npm run build:vendor",
    "prebuild:singlefile": "npm run copy-ifc-assets && npm run build:vendor",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "audit:security": "npm audit --audit-level=high",
    "build:vendor": "node scripts/build-thatopen-vendor.mjs",
    "prebuild:arena": "npm run copy-ifc-assets && npm run build:vendor",
    "postbuild": "node scripts/verify-build-artifacts.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "tsc --noEmit"
    ]
  },
  "dependencies": {
    "@sentry/react": "^10.64.0",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.101.2",
    "@thatopen/components": "3.4.6",
    "@thatopen/fragments": "3.4.6",
    "camera-controls": "^3.1.2",
    "clsx": "2.1.1",
    "comlink": "^4.4.2",
    "decimal.js": "^10.6.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^10.7.18",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^16.6.6",
    "tailwind-merge": "3.4.0",
    "three": "0.185.1",
    "web-ifc": "^0.0.77",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.28.1",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "lint-staged": "^16.4.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^3.2.7"
  }
}
